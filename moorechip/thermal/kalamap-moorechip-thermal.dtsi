	cpu-1-9 {
		trips {
			thermal-engine-config {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};

			thermal-hal-config {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};

			fan_cpu19_config0: fan-cpu19-config0 {
				temperature = <55000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_cpu19_config1: fan-cpu19-config1 {
				temperature = <60000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_cpu19_config2: fan-cpu19-config2 {
				temperature = <65000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_cpu19_config3: fan-cpu19-config3 {
				temperature = <70000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_cpu19_config4: fan-cpu19-config4 {
				temperature = <75000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_cpu19_config5: fan-cpu19-config5 {
				temperature = <80000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_cpu19_config6: fan-cpu19-config6 {
				temperature = <85000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			fan_cdev_0 {
				trip = <&fan_cpu19_config0>;
				cooling-device = <&fan0 1 2>;
			};

			fan_cdev_1 {
				trip = <&fan_cpu19_config1>;
				cooling-device = <&fan0 2 3>;
			};

			fan_cdev_2 {
				trip = <&fan_cpu19_config2>;
				cooling-device = <&fan0 3 4>;
			};

			fan_cdev_3 {
