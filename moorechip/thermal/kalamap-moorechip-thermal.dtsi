&soc {
	fan_reg: fan_reg {
		compatible = "regulator-fixed";
		regulator-name = "fan_reg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&tlmm 109 GPIO_ACTIVE_HIGH>;
	};
};

&pm8550_gpios {
	pwm_gpio08 {
		pwm_gpio08_default: pwm_gpio08_default {
			pins = "gpio8";
			function = "func1"; /* SF1 For PWM4 */
			input-disable;
			output-enable;
			output-low;
			bias-disable;
			power-source = <1>; /* 1.8V */
			qcom,drive-strength = <2>;
			status = "okay";
		};
	};
};

&spmi_bus {
	qcom,pm8550@1 {
		fan0: pwm-fan@0 {
			compatible = "pwm-fan";
			status = "ok";
			pwms = <&pm8550_pwm_2 0 50000>; /* pwm4 */
			cooling-levels = <0 40 65 75 90 100 120 150 175>;
			pinctrl-names = "default";
			pinctrl-0 = <&pwm_gpio08_default>;
			fan-supply = <&fan_reg>;
			#cooling-cells = <2>;
		};
	};
};

&socd_trip {
	temperature = <99>;
};

&pm8010_m {
	status = "disabled";
};

&pm8010m_tz {
	status = "disabled";
};

&pm8010_n {
	status = "disabled";
};

&pm8010n_tz {
	status = "disabled";
};

&pmk8550_vadc {
	pm8550_msm_therm {
		status = "disabled";
	};

	pm8550_cam_flash_therm {
		status = "disabled";
	};

	pm8550_wlan_therm {
		status = "disabled";
	};

	pm8550_pa_therm_1 {
		status = "disabled";
	};

	pm8550_rear_tof_therm {
		status = "disabled";
	};

	pm8550_amux2_volt {
		reg = <PM8550_ADC5_GEN3_AMUX_THM2>;
		label = "pm8550_amux2_volt";
		qcom,pre-scaling = <1 1>;
	};

	pm8550_amux4_volt {
		reg = <PM8550_ADC5_GEN3_AMUX_THM4>;
		label = "pm8550_amux4_volt";
		qcom,pre-scaling = <1 1>;
	};

	pm8550_amux5_volt {
		reg = <PM8550_ADC5_GEN3_AMUX_THM5>;
		label = "pm8550_amux5_volt";
		qcom,pre-scaling = <1 1>;
	};
};

