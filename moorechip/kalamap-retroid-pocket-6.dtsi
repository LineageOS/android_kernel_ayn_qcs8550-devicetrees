		multi-led@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;
			color = <LED_COLOR_ID_MULTI>;
			label = "right:bottom-right";

			led@9 {
				reg = <9>;
				color = <LED_COLOR_ID_RED>;
			};

			led@10 {
				reg = <10>;
				color = <LED_COLOR_ID_GREEN>;
			};

			led@11 {
				reg = <11>;
				color = <LED_COLOR_ID_BLUE>;
			};
		};
	};
};

// TODO: Unknown, but removal of this breaks booting recovery.
&L1B {
	regulator-always-on;
};

&joystick {
	moorechip,layout-nintendo;
};

&pm8550_rgb {
	status = "disabled";
};
